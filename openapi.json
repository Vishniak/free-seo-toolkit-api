{
  "openapi": "3.1.0",
  "info": {
    "title": "SEO Matrix - All-in-One SEO & Schema API",
    "description": "Ultra-fast micro-services for JSON-LD Schema generation, LSI keywords, Helpful Content audits, URL slugifying, readability, and meta inspection.",
    "version": "1.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/seo/slugify": {
      "post": {
        "summary": "Generate Slug",
        "description": "Generate clean, SEO-friendly, stop-word-free URL slug.",
        "operationId": "generate_slug_v1_seo_slugify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlugifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlugifyResponse"
