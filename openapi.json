                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContentAuditRequest": {
        "properties": {
          "text_or_html": {
            "type": "string",
            "title": "Text Or Html",
            "example": "<h1>Title</h1><p>First long paragraph about SEO optimization and best practices for developers.</p><p>Second paragraph providing actionable tips.</p>"
          }
        },
        "type": "object",
        "required": [
          "text_or_html"
        ],
        "title": "ContentAuditRequest"
      },
      "ContentAuditResponse": {
        "properties": {
          "word_count": {
            "type": "integer",
            "title": "Word Count"
          },
          "paragraph_count": {
            "type": "integer",
            "title": "Paragraph Count"
          },
          "avg_words_per_sentence": {
            "type": "number",
            "title": "Avg Words Per Sentence"
          },
          "helpful_content_score": {
            "type": "integer",
            "title": "Helpful Content Score"
          },
          "thin_content_warning": {
            "type": "boolean",
            "title": "Thin Content Warning"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "type": "object",
        "required": [
          "word_count",
          "paragraph_count",
          "avg_words_per_sentence",
          "helpful_content_score",
          "thin_content_warning",
          "recommendations"
        ],
        "title": "ContentAuditResponse"
      },
      "FAQItem": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "example": "What is FastAPI?"
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "example": "FastAPI is a high-performance Python web framework."
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "FAQItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeywordItem": {
        "properties": {
          "keyword": {
            "type": "string",
            "title": "Keyword"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "density_percent": {
            "type": "number",
            "title": "Density Percent"
          }
        },
        "type": "object",
        "required": [
          "keyword",
          "count",
          "density_percent"
        ],
        "title": "KeywordItem"
      },
      "KeywordRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "example": "FastAPI is a modern, fast Web framework for Python. Python is great for AI."
          },
          "top_n": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top N",
            "default": 5,
            "example": 5
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "KeywordRequest"
      },
      "KeywordResponse": {
        "properties": {
          "total_words": {
            "type": "integer",
            "title": "Total Words"
          },
          "top_keywords": {
            "items": {
              "$ref": "#/components/schemas/KeywordItem"
            },
            "type": "array",
            "title": "Top Keywords"
          }
        },
        "type": "object",
        "required": [
          "total_words",
          "top_keywords"
        ],
        "title": "KeywordResponse"
      },
      "LinkCheckRequest": {
        "properties": {
          "html_content": {
            "type": "string",
            "title": "Html Content",
            "example": "<html><body><a href='/about'>About Us</a><a href='https://google.com' rel='nofollow'>Google</a></body></html>"
          },
          "base_domain": {
            "type": "string",
            "title": "Base Domain",
            "default": "example.com",
            "example": "example.com"
          }
        },
        "type": "object",
        "required": [
          "html_content"
        ],
        "title": "LinkCheckRequest"
      },
      "LinkCheckResponse": {
        "properties": {
          "total_links": {
            "type": "integer",
            "title": "Total Links"
          },
          "internal_links_count": {
            "type": "integer",
            "title": "Internal Links Count"
          },
          "external_links_count": {
            "type": "integer",
            "title": "External Links Count"
          },
          "nofollow_links_count": {
            "type": "integer",
            "title": "Nofollow Links Count"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkItem"
            },
            "type": "array",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "total_links",
          "internal_links_count",
          "external_links_count",
          "nofollow_links_count",
          "links"
        ],
        "title": "LinkCheckResponse"
      },
      "LinkItem": {
        "properties": {
          "href": {
            "type": "string",
            "title": "Href"
          },
          "anchor_text": {
            "type": "string",
            "title": "Anchor Text"
          },
          "is_internal": {
            "type": "boolean",
            "title": "Is Internal"
          },
          "is_nofollow": {
            "type": "boolean",
            "title": "Is Nofollow"
          }
        },
        "type": "object",
        "required": [
          "href",
          "anchor_text",
          "is_internal",
          "is_nofollow"
        ],
        "title": "LinkItem"
      },
      "LsiKeywordsRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "example": "FastAPI is great for building high performance web APIs. High performance web applications use FastAPI."
          },
          "min_words": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Words",
            "default": 2,
            "example": 2
          },
          "max_words": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Words",
            "default": 3,
            "example": 3
          },
          "top_n": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top N",
            "default": 10,
            "example": 10
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "LsiKeywordsRequest"
      },
      "LsiKeywordsResponse": {
        "properties": {
          "total_phrases_extracted": {
            "type": "integer",
            "title": "Total Phrases Extracted"
          },
          "top_ngrams": {
            "items": {
              "$ref": "#/components/schemas/NgramItem"
            },
            "type": "array",
            "title": "Top Ngrams"
          }
        },
        "type": "object",
        "required": [
          "total_phrases_extracted",
          "top_ngrams"
        ],
        "title": "LsiKeywordsResponse"
      },
      "MetaInspectRequest": {
        "properties": {
          "html_content": {
            "type": "string",
            "title": "Html Content",
            "example": "<html><head><title>My Great Article Page</title><meta name='description' content='A short description here.'></head><body><h1>Main Title</h1></body></html>"
          }
        },
        "type": "object",
        "required": [
          "html_content"
        ],
        "title": "MetaInspectRequest"
      },
      "MetaInspectResponse": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "title_length": {
            "type": "integer",
            "title": "Title Length"
          },
          "title_status": {
            "type": "string",
            "title": "Title Status"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "description_length": {
            "type": "integer",
            "title": "Description Length"
          },
          "description_status": {
            "type": "string",
            "title": "Description Status"
          },
          "h1_count": {
            "type": "integer",
            "title": "H1 Count"
          },
          "has_canonical": {
            "type": "boolean",
            "title": "Has Canonical"
          },
          "has_og_image": {
            "type": "boolean",
            "title": "Has Og Image"
          }
        },
        "type": "object",
        "required": [
          "title",
          "title_length",
          "title_status",
          "description",
          "description_length",
          "description_status",
          "h1_count",
          "has_canonical",
          "has_og_image"
        ],
        "title": "MetaInspectResponse"
      },
      "NgramItem": {
        "properties": {
          "phrase": {
            "type": "string",
            "title": "Phrase"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "phrase",
          "count"
        ],
        "title": "NgramItem"
      },
      "ReadabilityRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "example": "FastAPI is an asynchronous web framework built on top of Starlette and Pydantic."
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ReadabilityRequest"
      },
      "ReadabilityResponse": {
        "properties": {
          "word_count": {
            "type": "integer",
            "title": "Word Count"
          },
          "character_count": {
            "type": "integer",
            "title": "Character Count"
          },
          "estimated_reading_time_minutes": {
            "type": "number",
            "title": "Estimated Reading Time Minutes"
          },
          "reading_difficulty": {
            "type": "string",
            "title": "Reading Difficulty"
          }
        },
        "type": "object",
        "required": [
          "word_count",
          "character_count",
          "estimated_reading_time_minutes",
          "reading_difficulty"
        ],
        "title": "ReadabilityResponse"
      },
      "RobotsGeneratorRequest": {
        "properties": {
          "site_url": {
            "type": "string",
            "title": "Site Url",
            "default": "https://example.com",
            "example": "https://example.com"
          },
          "disallow_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disallow Paths",
            "default": [
              "/admin/",
              "/private/"
            ],
            "example": [
              "/admin/",
              "/private/"
            ]
          },
          "allow_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allow Paths",
            "default": [
              "/"
            ],
            "example": [
              "/"
            ]
          },
          "sitemap_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sitemap Url",
            "default": "https://example.com/sitemap.xml",
            "example": "https://example.com/sitemap.xml"
          },
          "user_agents": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agents",
            "default": [
              "*"
            ],
            "example": [
              "*"
            ]
          }
        },
        "type": "object",
        "title": "RobotsGeneratorRequest"
      },
      "RobotsGeneratorResponse": {
        "properties": {
          "robots_txt": {
            "type": "string",
            "title": "Robots Txt"
          },
          "rules_count": {
            "type": "integer",
            "title": "Rules Count"
          }
        },
        "type": "object",
        "required": [
          "robots_txt",
          "rules_count"
        ],
        "title": "RobotsGeneratorResponse"
      },
      "SchemaGenerateRequest": {
        "properties": {
          "schema_type": {
            "type": "string",
            "title": "Schema Type",
            "description": "Supported types: 'article', 'product', 'faq'",
            "example": "article"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "example": "How to Build Ultra-Fast APIs with Python"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "example": "Learn how to build production-ready APIs."
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "example": "https://example.com/fastapi-guide"
          },
          "author_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author Name",
            "default": "Editorial Team",
            "example": "John Doe"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "example": "https://example.com/banner.jpg"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price",
            "example": 29.99
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
