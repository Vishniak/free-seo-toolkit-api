              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/seo/lsi-keywords": {
      "post": {
        "summary": "Extract Lsi Keywords",
        "description": "Extract N-gram phrases (2-word and 3-word co-occurrences) for LSI Keyword Analysis.",
        "operationId": "extract_lsi_keywords_v1_seo_lsi_keywords_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LsiKeywordsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LsiKeywordsResponse"
