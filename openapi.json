              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadabilityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/seo/schema-generate": {
      "post": {
        "summary": "Generate Schema",
        "description": "Generate valid JSON-LD Structured Data (Schema.org) for Article, Product, or FAQ.",
        "operationId": "generate_schema_v1_seo_schema_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemaGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
